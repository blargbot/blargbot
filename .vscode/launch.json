{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "node: master",
            "type": "node",
            "request": "launch",
            "console": "integratedTerminal",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "node",
                "${workspaceFolder}/src/master/start.ts"
            ],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**",
                "**/.pnp.cjs",
                "**/.pnp.loader.mjs"
            ],
            "autoAttachChildProcesses": true,
            "preLaunchTask": {
                "type": "npm",
                "script": "watch"
            }
        },
        {
            "name": "node: cluster",
            "type": "node",
            "request": "launch",
            "console": "integratedTerminal",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "node",
                "--max-old-space-size=4096",
                "${workspaceFolder}/src/cluster/start.ts"
            ],
            "env": {
                "CLUSTER_ID": "0",
                "SHARDS_MAX": "1",
                "SHARDS_FIRST": "0",
                "SHARDS_LAST": "0"
            },
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**",
                "**/.pnp.cjs",
                "**/.pnp.loader.mjs"
            ],
            "autoAttachChildProcesses": true,
            "preLaunchTask": {
                "type": "npm",
                "script": "watch"
            }
        },
        {
            "name": "node: api",
            "type": "node",
            "request": "launch",
            "console": "integratedTerminal",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "node",
                "${workspaceFolder}/src/api/start.ts",
            ],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**",
                "**/.pnp.cjs",
                "**/.pnp.loader.mjs"
            ],
            "autoAttachChildProcesses": true,
            "preLaunchTask": {
                "type": "npm",
                "script": "watch"
            }
        },
        {
            "name": "node: current",
            "type": "node",
            "request": "launch",
            "console": "integratedTerminal",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "node",
                "${fileDirname}/${fileBasenameNoExtension}.js"
            ],
            "skipFiles": [
                "!.yarn/**",
                "**/.pnp.cjs",
                "**/.pnp.loader.mjs"
            ],
            "autoAttachChildProcesses": true,
            "preLaunchTask": {
                "type": "npm",
                "script": "watch"
            }
        },
        {
            "name": "mocha: all",
            "type": "node",
            "request": "launch",
            "console": "integratedTerminal",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "mocha",
                "--no-timeouts",
                "--recursive"
            ],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**",
                "**/.pnp.cjs",
                "**/.pnp.loader.mjs"
            ],
            "autoAttachChildProcesses": true,
            "preLaunchTask": {
                "type": "npm",
                "script": "watch"
            }
        },
        {
            "name": "mocha: current",
            "type": "node",
            "request": "launch",
            "console": "integratedTerminal",
            "runtimeExecutable": "yarn",
            "runtimeArgs": [
                "mocha",
                "--no-timeouts",
                "${fileDirname}/${fileBasenameNoExtension}.js"
            ],
            "skipFiles": [
                "<node_internals>/**",
                "**/node_modules/**",
                "**/.pnp.cjs",
                "**/.pnp.loader.mjs"
            ],
            "autoAttachChildProcesses": true,
            "preLaunchTask": {
                "type": "npm",
                "script": "watch"
            }
        }
    ]
}